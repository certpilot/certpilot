# Copy to deploy/.env and fill in. Referenced by docker-compose.yml.

# Required. Encrypts every stored private key and CA credential.
#
#   make generate-kek
#
# This value is not recoverable. Lose it and every sealed secret is gone. Put
# the real one in a secret manager and inject it; this file is for local work.
CERTPILOT_KEK=

# Required. Any PostgreSQL 14 or later — see docs/database.md.
CERTPILOT_DB_URL=postgres://user:password@host:5432/certpilot?sslmode=require

# Optional: previous KEKs, comma-separated, still able to decrypt during a
# rotation. See docs/operations.md.
CERTPILOT_KEK_RETIRED=

# Optional: identity provider. Without one, the config file must set
# auth.jwt_secret, and production mode requires one or the other.
CERTPILOT_JWKS_URL=
CERTPILOT_JWT_ISSUER=

# Optional: default Vault for CA accounts that do not name one. No token here —
# each CA account carries its own identity.
VAULT_ADDR=
VAULT_NAMESPACE=

# Path to the core's configuration file, mounted read-only into the container.
CERTPILOT_CONFIG=./config.production.yaml

# Optional: which images to run. Both default to a moving tag, which is the
# right default for evaluating and the wrong one for anything you depend on —
# a `docker compose pull` on a moving tag changes what is running without
# anybody deciding to.
#
# CERTPILOT_VERSION pins the core, the frontend and the migrate job.
# GATEWAY_VERSION pins the three gateways, which release on their own schedule
# from their own repositories.
CERTPILOT_VERSION=latest
GATEWAY_VERSION=0.2.0
